---
interface Settings {
  phone: string;
  whatsapp: string;
  telegram: string;
}
const { settings } = Astro.props as { settings: Settings };
const telHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;
const waHref = `https://wa.me/${settings.whatsapp.replace(/[^\d]/g, '')}`;
const tgHref = `https://t.me/${settings.telegram.replace(/^@/, '')}`;
---

<div class="fixed inset-x-0 bottom-0 z-30 flex border-t border-line bg-ink/95 backdrop-blur md:hidden">
  <a href={telHref} class="flex flex-1 flex-col items-center gap-1 py-3 text-paper">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.9c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z" fill="currentColor"/>
    </svg>
    <span class="text-[11px]">Позвонить</span>
  </a>
  <a href={waHref} target="_blank" rel="noopener" class="flex flex-1 flex-col items-center gap-1 border-x border-line py-3 text-paper">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2z" fill="currentColor"/>
    </svg>
    <span class="text-[11px]">WhatsApp</span>
  </a>
  <a href={tgHref} target="_blank" rel="noopener" class="flex flex-1 flex-col items-center gap-1 py-3 text-paper">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M21 4 2.8 11.2c-1 .4-1 1 .1 1.3l4.7 1.5 1.8 5.6c.2.6.4.7.9.4l2.6-2 4.6 3.4c.6.4 1.1.2 1.3-.5L23.9 5c.3-1-.4-1.5-1.4-1z" fill="currentColor"/>
    </svg>
    <span class="text-[11px]">Telegram</span>
  </a>
</div>
