---
import ObjectCard from './ObjectCard.astro';
import { getCollection } from 'astro:content';

const objects = (await getCollection('objects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="objects" class="hairline">
  <div class="container-page py-20 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow mb-4">Объекты</p>
        <h2 class="max-w-xl font-display text-display-md text-paper">Библиотека разборов, а не каталог объявлений</h2>
      </div>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        objects.map((obj) => (
          <ObjectCard
            title={obj.data.title}
            industry={obj.data.industry}
            price={obj.data.price}
            city={obj.data.city}
            sold={obj.data.sold}
            cover={obj.data.cover}
            videoUrl={obj.data.videoUrl}
            summary={obj.data.summary}
          />
        ))
      }
    </div>
  </div>
</section>
